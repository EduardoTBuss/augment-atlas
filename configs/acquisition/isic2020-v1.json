    "image_name_regex": "^ISIC_\\d{7}$",
    "ignored_member_regexes": ["(^|/)__MACOSX/", "(^|/)\\.DS_Store$", "(^|/)\\._[^/]*$"],
    "group_prefix": "isic20-g-"
  },
  "documented_counts": {
